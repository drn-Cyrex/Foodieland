      "title": "Strawberry Oatmeal Pancake with Honey Syrup",
      "description": "A fluffy oat‑based pancake topped with fresh strawberries and sweet honey.",
      "category": "breakfast",
      "time": {
         "prep": 15,
         "cook": 15
      },
      "tags": ["sweet", "quick", "popular"],
      "backgroundImgSrc": "images/recipes/breakfast/2.png",
      "isLiked": true,
      "video": {
         "sources": [
            {
               "src": "videos/preview-video.mp4",
               "type": "video/mp4"
            }
         ],
         "poster": "video-posters/poster.jpg"
      },
      "nutrition": {
         "title": "Nutrition Information",
         "facts": [
            {
               "label": "Calories",
               "value": "219.9 kcal"
            },
            {
               "label": "Total Fat",
               "value": "10.7 g"
            },
            {
               "label": "Protein",
               "value": "7.9 g"
            },
            {
               "label": "Carbohydrate",
               "value": "22.3 g"
            },
            {
               "label": "Cholesterol",
               "value": "37.4 mg"
            }
         ],
         "note": "Adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
      },
      "ingredients": {
         "title": "Ingredients",
         "groups": [
            {
               "groupName": "For main dish",
               "items": [
                  "1 cup rolled oats",
                  "1/2 cup all-purpose flour",
                  "1 tablespoon sugar",
                  "1 teaspoon baking powder",
                  "1/2 teaspoon salt",
                  "3/4 cup milk",
                  "1 large egg",
                  "1 teaspoon vanilla extract"
               ]
            },
            {
               "groupName": "For the topping",
               "items": [
                  "1 cup fresh strawberries, sliced",
                  "1/4 cup honey",
                  "1 tablespoon lemon juice"
               ]
            }
         ]
      },
      "directions": {
         "title": "Directions",
         "steps": [
            {
               "title": "Prepare the dry ingredients",
               "description": "In a large mixing bowl, combine the rolled oats, all-purpose flour, sugar, baking powder, and salt. Whisk them together until evenly distributed."
            },
            {
               "title": "Mix the wet ingredients",
               "description": "In a separate bowl, whisk together the milk, eggs, and vanilla extract until smooth and well combined."
            },
            {
               "title": "Combine the batter",
               "description": "Pour the wet ingredients into the dry ingredients. Stir gently with a spatula until just combined. Be careful not to overmix; a few lumps are perfectly fine. Let the batter rest for 5 minutes to allow the oats to absorb the liquid."
            },
            {
               "title": "Cook the pancakes",
               "description": "Heat a non-stick griddle or frying pan over medium heat and lightly grease it with butter or oil. Pour about 1/4 cup of batter onto the pan for each pancake. Cook until bubbles form on the surface, then flip and cook the other side until golden brown."
            },
            {
               "title": "Prepare the honey syrup",
               "description": "While the pancakes are cooking, gently warm the honey in a small saucepan over low heat. Stir in the fresh lemon juice to balance the sweetness."
            },
            {
               "title": "Serve and enjoy",
               "description": "Stack the warm pancakes on a plate. Top generously with fresh sliced strawberries and drizzle with the warm honey syrup. Serve immediately."
            }
         ]
      }
